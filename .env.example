# Copy to .env (never commit .env). Defaults shown are used when a variable is unset.

# --- Server ---
PORT=3000
# development | production (production hides /api/docs)
APP_ENV=development
# Enable the dev-only login shortcut. NEVER enable in production.
DEV_LOGIN=false
# Public base URL (used for OAuth redirects and share links)
APP_BASE_URL=http://localhost:3000
# Extra origins allowed to make state-changing requests (comma-separated, CSRF Origin check).
# APP_BASE_URL's origin is always allowed. Unset in development defaults to the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite://data/bento.db

# --- Generic OIDC (Authorization Code + PKCE S256) ---
# Set issuer + client id together. Both empty = disabled. Discovery is automatic.
# Redirect URI at your provider: APP_BASE_URL/auth/oidc/callback
# Required claims: sub, email, email_verified=true; scopes: openid email profile.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Public client (PKCE / token authentication "none"): leave empty.
# Confidential client (client_secret_basic): set the secret here.
OIDC_CLIENT_SECRET=
# Logout only clears this application's session; Post Logout URIs can stay empty.

# --- Local backup admin (email + password) ---
# Only ADMIN_EMAIL may log in locally; other existing accounts cannot use passwords.
# Unset = enabled iff ADMIN_EMAIL is set. false = /auth/password-login returns 404.
PASSWORD_LOGIN_ENABLED=
# Create the admin with the CLI (preferred, nothing secret in the environment):
#   server admin create --email you@example.com --name "Your Name"
# Keep ADMIN_EMAIL set, including when using the CLI. ADMIN_PASSWORD is optional bootstrap:
# at startup creates a local account if absent, never overwrites its password.
# Remove ADMIN_PASSWORD after first start, but retain ADMIN_EMAIL for backup login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI import ---
# With a key, photos are read by the model. Without one the AI import buttons are hidden,
# unless AI_DEMO=true (development only), which answers with scripted sample data.
# Connection (same names for every AI_PROVIDER):
#   AI_API_KEY   the key; setting it enables AI import
#   AI_BASE_URL  API origin. Empty = https://api.anthropic.com for anthropic. Required for
#                openai-compatible / openai-responses (with or without a trailing /v1; /v1/chat/completions
#                resp. /v1/responses is appended).
# The older ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL are still read for the two Anthropic providers
# (anthropic, anthropic-compatible) when the AI_* variant is unset; AI_* wins. They are never used
# for openai-compatible and openai-responses.
AI_API_KEY=
AI_BASE_URL=
# Required with openai-compatible / openai-responses (there is no useful default); claude-opus-5-5 otherwise.
AI_MODEL=claude-opus-5-5
# Extra HTTP headers on every model request: name=value,name2=value2 (no commas inside values).
# Values are treated as secrets and never logged.
# AI_EXTRA_HEADERS=x-team=bento
# Name of a header that carries the import run id (one fresh id per run, shared by its model calls),
# for gateways that route by session. opencode Go needs x-opencode-session.
# AI_SESSION_HEADER=x-opencode-session
# Max model calls per import run (list -> get -> propose -> fix -> summary)
AI_MAX_TURNS=8
AI_DAILY_QUOTA_PER_USER=30
# anthropic (default) = Anthropic's own API, Claude defaults.
# anthropic-compatible = a gateway that speaks the Messages API in front of another model (Qwen via
#   vLLM/LiteLLM/...): point AI_BASE_URL / AI_API_KEY / AI_MODEL at it. Defaults then
#   become AI_FALLBACKS=off, AI_STRICT_TOOLS=false, AI_REASONING=off (the plain Messages subset).
# openai-compatible = any server that speaks OpenAI Chat Completions (DeepSeek, vLLM, LiteLLM,
#   opencode, ...). Same defaults as anthropic-compatible; AI_REASONING=low sends reasoning_effort=low.
# openai-responses = servers (or models) that only speak the OpenAI Responses API (POST /v1/responses,
#   e.g. gpt-6-luna on opencode Go). Same connection settings and defaults as openai-compatible;
#   stateless (store=false, encrypted reasoning items replayed); AI_REASONING=low sends reasoning.effort=low.
AI_PROVIDER=anthropic
# default = ask the API to fall back to another model when a request is refused; off = no fallback.
# `default` is only valid with AI_PROVIDER=anthropic (default there; off for anthropic-compatible).
AI_FALLBACKS=default
# strict: true tool schemas (default: true for anthropic, false for the compatible providers)
# AI_STRICT_TOOLS=true
# low = send output_config.effort=low (+ adaptive thinking) / reasoning_effort=low (openai-compatible);
# off = send no reasoning parameters (the server's own default)
# (default: low for anthropic, off for the compatible providers)
# AI_REASONING=low
# Timeouts in seconds: one model call (HTTP request) and a whole import run incl. the single retry.
# Defaults: 60 / 90 for anthropic, 180 / 300 for the compatible providers (slow gateways, e.g. quantised
# models, need minutes). Both > 0 and REQUEST <= RUN. A timed-out call is not retried. The import
# request stays open for up to RUN seconds: reverse proxies must allow it (nginx proxy_read_timeout,
# Cloudflare ~100 s).
# AI_REQUEST_TIMEOUT_SECS=60
# AI_RUN_TIMEOUT_SECS=90
# Scripted demo agent for local development without a key. Refused when APP_ENV=production.
AI_DEMO=false

# --- Sessions / privacy ---
SESSION_TTL_DAYS=14
# Reverse-proxy IP ranges whose X-Forwarded-For is trusted; empty = trust none
TRUSTED_PROXIES=
# Submissions of groups closed longer ago than this have IP/UA/device info cleared
CLIENT_INFO_RETENTION_DAYS=90
# How often the background cleanup job runs (first run 30 s after startup)
MAINTENANCE_INTERVAL_HOURS=24

# --- Public endpoint rate limit (per client IP; token bucket) ---
PUBLIC_RATE_LIMIT_BURST=30
PUBLIC_RATE_LIMIT_PER_SEC=2

# --- Link previews (/g/{token} Open Graph tags) ---
# Timezone used to render the deadline in the preview description
DISPLAY_UTC_OFFSET=+08:00
