# Copy to .env (never commit .env). Defaults shown are used when a variable is unset.

# --- Server ---
PORT=3000
# development | production (production hides /api/docs)
APP_ENV=development
# Enable the dev-only login shortcut. NEVER enable in production.
DEV_LOGIN=false
# Public base URL (used for OAuth redirects and share links)
APP_BASE_URL=http://localhost:3000
# Extra origins allowed to make state-changing requests (comma-separated, CSRF Origin check).
# APP_BASE_URL's origin is always allowed. Unset in development defaults to the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite://data/bento.db

# --- Google OAuth/OIDC ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Unset = auto (enabled iff both credentials above are set). false = disabled even with
# credentials (tests / local setups). true without both credentials = startup error.
# When disabled, /auth/google/* answers 503 and the login page hides the Google button.
GOOGLE_OAUTH_ENABLED=

# --- Local accounts (email + password) ---
# Password login for local accounts (default true; false = POST /auth/password-login is 404).
PASSWORD_LOGIN_ENABLED=true
# Create local accounts with the CLI (preferred, nothing secret in the environment):
#   server admin create --email you@example.com --name "Your Name"
# ADMIN_EMAIL + ADMIN_PASSWORD (both or neither) is a bootstrap for containers: at startup, if no
# organizer with that email exists, the account is created. An existing account is never touched
# and the password is never overwritten from here. Remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI import (Anthropic Claude) ---
# With a key, photos are read by Claude. Without one the AI import buttons are hidden,
# unless AI_DEMO=true (development only), which answers with scripted sample data.
ANTHROPIC_API_KEY=
# Override the API origin (mock servers, gateways); empty = https://api.anthropic.com
ANTHROPIC_BASE_URL=
AI_MODEL=claude-opus-5-5
# Max model calls per import run (list -> get -> propose -> fix -> summary)
AI_MAX_TURNS=8
AI_DAILY_QUOTA_PER_USER=30
# anthropic (default) = Anthropic's own API, Claude defaults.
# anthropic-compatible = a gateway that speaks the Messages API in front of another model (Qwen via
#   vLLM/LiteLLM/...): point ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY / AI_MODEL at it. Defaults then
#   become AI_FALLBACKS=off, AI_STRICT_TOOLS=false, AI_REASONING=off (the plain Messages subset).
AI_PROVIDER=anthropic
# default = ask the API to fall back to another model when a request is refused; off = no fallback.
# `default` is only valid with AI_PROVIDER=anthropic (default there; off for anthropic-compatible).
AI_FALLBACKS=default
# strict: true tool schemas (default: true for anthropic, false for anthropic-compatible)
# AI_STRICT_TOOLS=true
# low = send output_config.effort=low (+ adaptive thinking); off = send no reasoning parameters
# (default: low for anthropic, off for anthropic-compatible)
# AI_REASONING=low
# Scripted demo agent for local development without a key. Refused when APP_ENV=production.
AI_DEMO=false

# --- Sessions / privacy ---
SESSION_TTL_DAYS=14
# Reverse-proxy IP ranges whose X-Forwarded-For is trusted; empty = trust none
TRUSTED_PROXIES=
# Submissions of groups closed longer ago than this have IP/UA/device info cleared
CLIENT_INFO_RETENTION_DAYS=90
# How often the background cleanup job runs (first run 30 s after startup)
MAINTENANCE_INTERVAL_HOURS=24

# --- Public endpoint rate limit (per client IP; token bucket) ---
PUBLIC_RATE_LIMIT_BURST=30
PUBLIC_RATE_LIMIT_PER_SEC=2

# --- Link previews (/g/{token} Open Graph tags) ---
# Timezone used to render the deadline in the preview description
DISPLAY_UTC_OFFSET=+08:00

# --- Litestream backup (Docker image only; set LITESTREAM_BUCKET to enable) ---
LITESTREAM_BUCKET=
LITESTREAM_PATH=bento
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
